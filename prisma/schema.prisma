generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  password  String?
  isPro     Boolean  @default(false)
  credits   Int      @default(0)
  isTrial       Boolean  @default(false)
  registrationIp String?
  events        Event[]
  leads     Lead[]
}

model Lead {
  id               String            @id @default(uuid())
  userId           String
  formData         Json
  cvText           String?
  status           String            @default("INTAKE_RECEIVED") // INTAKE_RECEIVED, AWAITING_REVIEW, DIAGNOSIS_GENERATED, MODULES_GENERATED, PENDING_APPROVAL, DELIVERED, FOLLOW_UP_REQUIRED
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  // Phase 2 Relations
  intake           Intake?
  scores           EmployabilityScore[]
  modules          AIModule[]
  diagnostics      Diagnostic[]
  tracking         Tracking[]
  
  // Phase 4 Portal Fields
  portalToken      String?           @unique
  portalAccessActive Boolean         @default(false)

  // Legacy Relations (kept for stability)
  decisions        Decision[]
  personalizedPlan PersonalizedPlan?
  oldScores        Score[]
  tags             Tag[]
  
  user             User              @relation(fields: [userId], references: [id])
}

model Intake {
  id              String   @id @default(uuid())
  leadId          String   @unique
  rawTallyData    Json
  resumeUrl       String?
  linkedinUrl     String?
  goals           String?
  behavioralData  Json?
  emotionalState  String?
  createdAt       DateTime @default(now())
  lead            Lead     @relation(fields: [leadId], references: [id])
}

model EmployabilityScore {
  id              String   @id @default(uuid())
  leadId          String
  category        String   // ATS_READINESS, POSITIONING_CLARITY, EXECUTIVE_BRANDING, VISIBILITY_STRENGTH, NETWORKING_MATURITY, INTERVIEW_READINESS, EMOTIONAL_SUSTAINABILITY, HIDDEN_MARKET_READINESS
  value           Int      // 0-100
  justification   String   @db.Text
  recommendations String[]
  isEditable      Boolean  @default(true)
  createdAt       DateTime @default(now())
  lead            Lead     @relation(fields: [leadId], references: [id])

  @@unique([leadId, category])
}

model AIModule {
  id              String   @id @default(uuid())
  leadId          String
  agentName       String   // IntakeParser, PositioningStrategist, ResumeStrategist, LinkedInBranding, VisibilityStrategy, NetworkingStrategy, InterviewStrategy, ExecutionPsychology, PlaybookDecision
  content         Json
  status          String   @default("GENERATED") // GENERATED, APPROVED, REJECTED
  version         Int      @default(1)
  dependencies    String[] // Array of agentNames
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lead            Lead     @relation(fields: [leadId], references: [id])
}

model Diagnostic {
  id              String   @id @default(uuid())
  leadId          String
  type            String   // PSYCHOLOGICAL, MARKET_FIT, TECHNICAL, BEHAVIORAL
  payload         Json
  findings        String[]
  metadata        Json?
  createdAt       DateTime @default(now())
  lead            Lead     @relation(fields: [leadId], references: [id])
}

model Tracking {
  id              String   @id @default(uuid())
  leadId          String
  actionType      String   // NETWORKING, APPLICATION, INTERVIEW, LEARNING
  details         Json
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  lead            Lead     @relation(fields: [leadId], references: [id])
}

model PersonalizedPlan {
  id        String   @id @default(uuid())
  leadId    String   @unique
  modules   Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model Event {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Score {
  id        String   @id @default(uuid())
  leadId    String
  level     String
  summary   String
  gaps      Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model Decision {
  id        String   @id @default(uuid())
  leadId    String
  strategy  String
  message   String?
  offer     String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model Tag {
  id        String   @id @default(uuid())
  leadId    String
  name      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@unique([leadId, name])
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  maxUses     Int      @default(1)
  currentUses Int      @default(0)
  isActive    Boolean  @default(true)
  grantedCredits Int      @default(10)
  description    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
